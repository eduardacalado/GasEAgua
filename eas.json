{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "APP_ENV": "preview"
      }
    },
    "hml": {
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "APP_ENV": "hml"
      }
    }
  },
  "submit": {
    "hml": {
      "android": {
        "track": "internal"
      }
    }
  }
}
